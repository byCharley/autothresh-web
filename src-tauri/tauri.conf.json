{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoThresh",
  "version": "1.0.0",
  "identifier": "com.autothresh.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "assets/dmg-background.png",
        "appPosition": { "x": 165, "y": 150 },
        "applicationFolderPosition": { "x": 425, "y": 150 },
        "windowSize": { "width": 640, "height": 360 }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
