{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/_lib/**,api/_data/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/close-tickets",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sunset-subscriptions",
      "schedule": "15 * * * *"
    }
  ]
}
